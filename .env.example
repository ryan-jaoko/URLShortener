# ==============================================================================
# URLShortener Root Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file or use the subproject specific .env files in:
# - url-shortener-api/.env.example
# - url-shortener-web/.env.example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: ASP.NET Core API (url-shortener-api)
# Note: In ASP.NET Core, environment variables use double underscore '__' for sections.
# Secrets can also be configured with `dotnet user-secrets`.
# ------------------------------------------------------------------------------

# PostgreSQL Database Connection String
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=URLShortener;Username=postgres;Password= "

# JWT Authentication Configuration
Jwt__Issuer="Shortpath"
Jwt__Audience="ShortpathWeb"
Jwt__Key="YourSuperSecretLongKeyHereMinimum32CharactersLong!"
Jwt__ExpiresMinutes="10080"

# CORS Origin (allowed frontend URL)
Cors__Origin="http://localhost:5173"

# Public URL used to form full short links in API responses
PublicBaseUrl="http://localhost:5062"

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT="Development"
ASPNETCORE_URLS="http://localhost:5062"

# ------------------------------------------------------------------------------
# Frontend: Vue / Vite Web App (url-shortener-web)
# Note: Vite only exposes environment variables prefixed with 'VITE_'.
# ------------------------------------------------------------------------------

# API Base URL (backend address)
VITE_API_BASE_URL="http://localhost:5062"

# Public Short Link Redirect Origin
VITE_PUBLIC_SHORT_BASE_URL="http://localhost:5062"
